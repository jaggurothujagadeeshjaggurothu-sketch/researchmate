# Copy to .env (optional - defaults work with a local Ollama install)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Optional: only needed if you select "Gemini API" in Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_TIMEOUT=180
AI_MAX_ATTEMPTS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
